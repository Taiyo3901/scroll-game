{
  "manifest_version": 3,
  "name": "迷宮スクロール（仮称）",
  "version": "0.6.0",
  "key": "",
  "description": "スクロールで迷宮を降り、立ち止まって入れ物を物色すると、見ているサイトの種類にまつわる品が見つかる。いつものブラウジングにプラスαの探索ゲーム。",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "oauth2": {
    "client_id": "762979997726-jbm59ve4mp9uomn57qdk3cu7blq3u0s0.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-DyFvbzk-.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "迷宮スクロール（仮称）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "src/icons/icon16.png",
      "32": "src/icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "assets/depth-PpLhwrWV.js",
        "assets/job-CfC_7-oG.js",
        "assets/storage-D0Sp_HqT.js",
        "assets/sprites-C-_tsd3W.js",
        "assets/overlay-Y1Wdr9LJ.js",
        "assets/game-Bug-glvX.js",
        "assets/rules-Bkn3f-d_.js",
        "assets/src-content-index.ts-BOhQrHnl.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
